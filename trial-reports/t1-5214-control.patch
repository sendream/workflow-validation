+    def test_fmt_skip_leaf_has_bracket_depth(self) -> None:
+        source = """\
+import tempfile
+
+package_name_raw = "logging-strict"
+is_test_file_1 = True
+with tempfile.TemporaryDirectory() as fp:
+    path_alternative_dest_folder_1 = fp
+    reg = dict(  # type: ignore[arg-type]  # pyright: ignore[something]  # fmt: skip
+        package_name_raw,
+        path_alternative_dest_folder=path_alternative_dest_folder_1,  # type: ignore[arg-type]
+        is_test_file=is_test_file_1,
+    )
+"""
+        root = black.lib2to3_parse(source)
+        black.normalize_fmt_off(root, Mode(), ())
+
+        fmt_skip_leaves = [
+            leaf for leaf in root.leaves() if leaf.type == STANDALONE_COMMENT
+        ]
+        self.assertEqual(len(fmt_skip_leaves), 1)
+        self.assertEqual(fmt_skip_leaves[0].bracket_depth, 0)
+
